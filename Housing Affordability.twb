      <size maxheight='964' maxwidth='1016' minheight='964' minwidth='1016' />
      <zones>
        <zone h='100000' id='2' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98340' id='9' param='vert' removable='false' type-v2='layout-flow' w='98426' x='787' y='830'>
            <zone h='98340' id='1' param='vert' removable='false' type-v2='layout-flow' w='98426' x='787' y='830'>
              <zone fixed-size='153' h='15871' id='4' is-fixed='true' paired-zone-id='5' removable='false' type-v2='flipboard-nav' w='98426' x='787' y='830' />
              <zone h='82469' id='5' paired-zone-id='4' removable='false' type-v2='flipboard' w='98426' x='787' y='16701'>
                <flipboard active-id='6' nav-type='caption' show-nav-arrows='true'>
                  <story-points>
                    <story-point caption='Despite varying Growth Rates the Difference in Prices of Housing generally depends on the Increase in Inflation in that Particular Country.' captured-sheet='Sheet 2' id='7' />
                    <story-point caption='People with High incomes prefer Expensive to Medium Range Accommodations while Low income ones Prefer Cheaper Housing.' captured-sheet='Sheet 3' id='2' />
                    <story-point caption='Higher Population Growth results in High PPP Index which in turn Results in Inaffordability in Housing Prices.' captured-sheet='Sheet 4' id='3' />
                    <story-point caption='While Inflation Rate plays little Role in Interst Rates the difference in both rates is more in countries with Low Inflation as compared to Countries with High inflation.' captured-sheet='Sheet 5' id='4' />
                    <story-point caption='A Declining Economy shows Average to Mid-Range Housing prices while if the Market of a Country is Booming the Housing Prices don&apos;t become Cheap in turn they lie more in Mid to High Range.' captured-sheet='Sheet 6' id='5'>
                      <capturedDeltas>
                        <worksheet name='Sheet 6'>
                          <selection-collection>
                            <node-selection select-tuples='false'>
                              <oriented-node-reference orientation='vertical'>
                                <node-reference>
                                  <axis>[federated.06nsvzv0g1fzl2138lfw719i8m90].[avg:Price_2025:qk]</axis>
                                </node-reference>
                                <page-reference />
                              </oriented-node-reference>
                            </node-selection>
                          </selection-collection>
                        </worksheet>
                      </capturedDeltas>
                    </story-point>
                    <story-point caption='Dashboard of How growth Rate, Inaffordability Ratio &amp; PPP Index influence Housing Affordability.' captured-sheet='Dashboard 1' id='6' />
                    <story-point caption='Dashboard of How Inflation Rate, Interest Rate &amp; House Preference influence Housing Affordability across the Years of 2015 to 2025.' captured-sheet='Dashboard 2' id='8' />
                  </story-points>
                </flipboard>
              </zone>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
      <simple-id uuid='{E5C72736-C33E-4C10-9B05-03934E06907C}' />
    </dashboard>
